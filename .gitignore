__pycache__/
*.pyc

# Computed results. The directory is ignored by default -- three of the
# grid-based .npz files are 192-293 MB, past GitHub's 100 MB per-file
# limit -- but the small, expensive-to-recompute ones are kept.
#
# Note "results/*" rather than "results/": git does not descend into an
# ignored DIRECTORY, so the negations below would never be seen.
results/*
!results/*.npy
!results/strain_model3.npz
!results/vp_model3.npz
!results/vp_model3_nocap.npz

# PFC exports. Regenerated by pfc_pipeline.py / friction_sweep.py --run;
# a single run is ~7 files of one line per particle.
runs/
